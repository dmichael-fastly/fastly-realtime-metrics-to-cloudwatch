[edge]
# Set to false to disable standard edge metrics polling
enabled = true

# ==============================================================================
# DEFAULT EDGE METRICS
# ==============================================================================
# Recommended defaults for standard edge metrics.
# requests = hits + misses + pass + synth + errors, so tracking all five lets you
# alert on cache efficiency and synthetic-response spikes (often WAF blocks or
# error pages), not just error counts.
metrics = requests, hits, misses, pass, synth, errors, bandwidth, status_2xx, status_3xx, status_4xx, status_5xx, status_400, status_401, status_403, status_404, status_500, status_502, status_503, status_504, miss_time, pass_time

# ==============================================================================
# ADDITIONAL EDGE METRICS (Remove a line to disable that group)
# ==============================================================================

# -- HTTP Status Codes --
# status_499 (client closed connection) is an early-warning sign of a slow origin
metrics_extra_status = status_1xx, status_200, status_204, status_206, status_301, status_302, status_304, status_400, status_401, status_403, status_404, status_406, status_416, status_429, status_499, status_500, status_501, status_502, status_503, status_504, status_505, status_530

# -- Traffic Volume & Cache Behavior --
metrics_extra_volume = misses, edge_requests, edge_hit_requests, edge_miss_requests, edge_resp_body_bytes, edge_resp_header_bytes, edge_hit_resp_body_bytes, edge_miss_resp_body_bytes, miss_time, pass_time

# -- Origin Fetch & Shielding --
metrics_extra_shield = shield, shield_fetches, shield_hit_requests, shield_fetch_body_bytes, shield_fetch_resp_body_bytes, segblock_origin_fetches, segblock_shield_fetches

# -- Security / WAF / DDoS --
metrics_extra_security = ddos_protection_requests_detect_count, ddos_protection_requests_mitigate_count, ddos_protection_requests_allow_count, attack_blocked_req_body_bytes, attack_logged_req_body_bytes, attack_passed_req_body_bytes

# -- TLS & Protocol Mix (Uncomment to enable) --
# Useful for alerting on deprecated TLS versions still in use
#metrics_extra_protocol = tls_v10, tls_v11, tls_v12, tls_v13, http2, http3

# -- Bot Management (Uncomment if you have the Bot Management product) --
#metrics_extra_bot = bot_requests_total_count, bot_edge_requests_detected_count, bot_edge_requests_verified_count, bot_challenges_issued, bot_challenges_succeeded, bot_challenges_failed

# -- Compute Advanced (Uncomment if this is a Compute service) --
#metrics_extra_compute = compute_requests, compute_request_time_ms, compute_execution_time_ms, compute_runtime_errors, compute_resp_status_5xx, compute_resource_limit_exceeded, compute_ram_used, compute_stack_limit_exceeded


[origin]
# Set to true if you have Fastly Origin Inspector enabled on your Fastly account
enabled = false

# ==============================================================================
# DEFAULT ORIGIN METRICS
# ==============================================================================
# NOTE: Unprefixed fields (responses, latency_*, ...) cover the VCL delivery path
# only. Origin Inspector also exposes compute_*, waf_*, and all_* variants of every
# field; on a Compute service, use the all_* family for true totals
# (e.g. all_responses, all_status_5xx, all_latency_0_to_1ms).
metrics = responses, bandwidth, status_2xx, status_3xx, status_4xx, status_5xx, latency_0_to_1ms, latency_1_to_5ms, latency_5_to_10ms, latency_10_to_50ms, latency_50_to_100ms, latency_100_to_250ms, latency_250_to_500ms, latency_500_to_1000ms, latency_1000_to_5000ms, latency_5000_to_10000ms, latency_10000_to_60000ms, latency_60000ms

# ==============================================================================
# ADDITIONAL ORIGIN METRICS (Remove a line to disable that group)
# ==============================================================================

# -- Specific Origin Status Codes --
metrics_extra_status = status_2xx, status_3xx, status_4xx, status_1xx, status_200, status_204, status_206, status_301, status_302, status_304, status_400, status_401, status_403, status_404, status_416, status_429, status_500, status_501, status_502, status_503, status_504, status_505, status_530
